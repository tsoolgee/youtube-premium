{
  "manifest_version": 3,
  "name": "יוטיוב פרימיום",
  "short_name": "יוטיוב פרימיום",
  "author": "צול גאה – TSOOLGEE.UK",
  "homepage_url": "https://tsoolgee.uk",
  "version": "2.1.3",
  "description": "חוויית YouTube Premium: בלי פרסומות, ניגון ברקע, הורדות (גם דרך שרת Drive), חלון צף, איכות מרבית ומהירויות עד פי 4.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "tabs", "notifications", "alarms", "cookies"],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "*://*.youtube.com/*",
    "https://*.google.com/*",
    "https://*.tsoolgee.uk/*"
  ],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://music.youtube.com/*"],
      "js": ["main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://music.youtube.com/*"],
      "js": ["settings.js", "bridge.js"],
      "run_at": "document_start"
    }
  ]
}
